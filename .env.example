# XPR Network Bot Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Your XPR Network account name
PROTON_USERNAME=your_account_name

# Your private key (starts with PVT_K1_)
PROTON_PRIVATE_KEY=PVT_K1_your_private_key_here

# Environment: test for testnet, production for mainnet
NODE_ENV=test

# Optional: Claude API key for AI-powered strategies
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: Telegram notifications
# TELEGRAM_BOT_TOKEN=123456:ABC-your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
